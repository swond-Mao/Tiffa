# Tiffa 模型配置文件（示例模板）
# =============================================
# 安装后复制本文件为 models.yml 并填入你的 API Key。
# 不填 Key 的供应商不会出现在可用模型里。
# =============================================
providers:
  # ── 本地模型（零成本，完全离线）──
  # 需先启动 llama.cpp 服务器:
  #   llama-server -m 模型路径.gguf --host 127.0.0.1 --port 11434
  llama-local:
    type: openai
    baseUrl: "http://LOCALHOST:11434/v1"
    apiKey: "not-needed"
    models:
      - name: "llama-local"
        label: "本地模型"
        disabled: false

# =============================================
# 国内云 API（按需填写 Key 后启用）
# 以下是常见提供方的配置示例，填入真实 Key 即可用。
# =============================================

# --- Kimi（Moonshot）---
# 注册: https://platform.moonshot.cn/
# kimi:
#   type: openai
#   baseUrl: "https://api.moonshot.cn/v1"
