# Tiffa 模型配置文件（发布版示例模板）
# =============================================
# 安装后复制本文件为 models.yml 并填入你的 API Key。
# 不填 Key 的供应商不会出现在可用模型里。
# 格式说明：本模板是内核实际解析的格式（api/baseUrl/apiKey/models[].id/input/supportsTools/contextWindow/maxTokens）。
# =============================================

# 使用示例（复制下方模板，按需添加供应商）：
# providers:
#   your-provider:
#     baseUrl: "https://api.example.com/v1"
#     api: "openai-completions"
#     apiKey: "sk-your-api-key-here"
#     models:
#       - id: "model-id"
#         name: "模型显示名称"
#         reasoning: false
#         input:
#           - "text"
#         supportsTools: true
#         contextWindow: 128000
#         maxTokens: 8192

# 下方为空白模板，复制上方示例并取消注释使用
providers:
