# Tiffa 模型配置文件（发布版示例模板）
# =============================================
# 安装后复制本文件为 models.yml 并填入你的 API Key。
# 不填 Key 的供应商不会出现在可用模型里。
# 看图/旁路：配置 bypass-model.json（第1层）+ vision-fallback.json（第2层），详见 skills/computer-use/GROUNDING.md。
# 格式说明：本模板是内核实际解析的格式（api/baseUrl/apiKey/models[].id/input/supportsTools/contextWindow/maxTokens）。
# =============================================

# Tiffa models.yml

providers:
  kimi:
    baseUrl: "https://api.moonshot.cn/v1"
    api: "openai-completions"
    apiKey: "none"  # 发布版已清空：使用者在此填自己的 Key（或改用旁路/MCP/auth）
    models:
      - id: "kimi-k3"
        name: "Kimi K3 (最新旗舰)"
        reasoning: true
        input:
          - "text"
          - "image"
        supportsTools: true
        contextWindow: 262144
        maxTokens: 32768
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0

  xiaomi:
    baseUrl: "https://api.xiaomimimo.com/v1"
    api: "openai-completions"
    apiKey: "none"  # 发布版已清空：使用者在此填自己的 Key（或改用旁路/MCP/auth）
    models:
      - id: "mimo-v2.5"
        name: "MiMo-V2.5 (轻量快速)"
        reasoning: false
        input:
          - "text"
        supportsTools: true
        contextWindow: 128000
        maxTokens: 8192
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
      - id: "mimo-v2.5-pro"
        name: "MiMo-V2.5-Pro (旗舰推理)"
        reasoning: true
        input:
          - "text"
        supportsTools: true
        contextWindow: 128000
        maxTokens: 8192
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0

  llama.cpp:
    baseUrl: "http://LOCALHOST:11434/v1"
    api: "openai-completions"
    apiKey: "none"
    models:
      - id: "localmodel"
        name: "家用模型（本地直连）"
        reasoning: true
        input:
          - "text"
          - "image"
        supportsTools: true
        contextWindow: 262144
        maxTokens: 8192
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0

  local-server:
    baseUrl: "http://YOUR_SERVER_IP:9876/v1"
    api: "openai-completions"
    apiKey: "none"
    models:
      - id: "localmodel"
        name: "家用模型（远程中继）"
        reasoning: true
        input:
          - "text"
          - "image"
        supportsTools: true
        contextWindow: 262144
        maxTokens: 8192
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0

  volcengine:
    baseUrl: "https://ark.cn-beijing.volces.com/api/coding/v3"
    api: "openai-completions"
    apiKey: "none"  # 发布版已清空：使用者在此填自己的 Key（或改用旁路/MCP/auth）
    models:
      - id: "glm-5.2"
        name: "GLM-5.2 (火山方舟 Coding Plan)"
        reasoning: true
        input:
          - "text"
        supportsTools: true
        contextWindow: 1024000
        maxTokens: 32768
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0

  minimax:
    baseUrl: "https://api.minimax.chat/v1"
    api: "openai-completions"
    apiKey: "none"  # 发布版已清空：使用者在此填自己的 Key（或改用旁路/MCP/auth）
    models:
      - id: "MiniMax-M3"
        name: "MiniMax M3 (100万上下文)"
        reasoning: false
        input:
          - "text"
        supportsTools: true
        contextWindow: 1000000
        maxTokens: 131072
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
      - id: "MiniMax-M2.7"
        name: "MiniMax M2.7"
        reasoning: false
        input:
          - "text"
          - "image"
        supportsTools: true
        contextWindow: 204800
        maxTokens: 131072
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0

  deepseek:
    baseUrl: "https://api.deepseek.com"
    api: "openai-completions"
    apiKey: "none"  # 发布版已清空：使用者在此填自己的 Key（或改用旁路/MCP/auth）
    # 关闭强制思考：内核内置 deepseek compat 带 extraBody.thinking.type=enabled（每回合强制思考），
    # 实测 deepseek-v4-flash 在思考模式下 agent 任务不稳定（思考200字就提前 end_turn → "回复到一半停/反复停止"），
    # 而 localmodel（本地模型无 reasoning）反而稳定。实测 API 接受 thinking.disabled（不再返回 reasoning_content）。
    compat:
      extraBody:
        thinking:
          type: "disabled"
    models:
      - id: "deepseek-v4-flash"
        name: "deepseek-v4-flash"
        reasoning: true
        input:
          - "text"
        supportsTools: true
        contextWindow: 1048576
        maxTokens: 32768 # 实测 API 支持 32768+；原 8192 被 thinking 占满导致"回复到一半停"(finish_reason=length)
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
      - id: "deepseek-v4-pro"
        name: "deepseek-v4-pro"
        reasoning: false
        input:
          - "text"
        supportsTools: true
        contextWindow: 128000
        maxTokens: 32768 # 实测 API 支持 32768
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0

  bypass-dynamic:
    # 动态旁路模型：claude-mode-extension.ts 在 session_start 时按 bypass-model.json 自动更新
    baseUrl: "http://YOUR_SERVER_IP:11434/v1"
    api: "openai-completions"
    apiKey: "none"
    models:
      - id: "localmodel"
        name: "旁路模型（动态视觉）"
        reasoning: true
        input:
          - "text"
          - "image"
        supportsTools: true
        contextWindow: 262144
        maxTokens: 16384
        cost:
          input: 0
          output: 0
          cacheRead: 0
          cacheWrite: 0
