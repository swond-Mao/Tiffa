{
  "version": "1.0",
  "name": "shared-visual-components",
  "description": "共享视觉组件库：canvas-design / pptgen / craftman 共用的 HTML/CSS 组件与主题。AI 做视觉设计时从本注册表选组件拼装，禁止从零手写 CSS。",
  "base_path": "$PORTABLE_ROOT/skills/shared-visual-components",
  "usage": {
    "引入方式": "在 HTML 中 <link rel=\"stylesheet\" href=\"<base>/core/reset.css\"> + <link rel=\"stylesheet\" href=\"<base>/core/variables.css\"> + <link rel=\"stylesheet\" href=\"<base>/core/utils.css\">，再按需引入主题和组件",
    "主题切换": "在 <body> 或根元素设置 data-theme=\"<主题id>\"，如 <body data-theme=\"aurora\">",
    "选择流程": "1) 判断需求类型→选 layout  → 2) 按效果需求选组件 → 3) 选主题 → 4) 填内容"
  },
  "themes": [
    { "id": "neumorphism", "name": "轻拟态风", "nameEn": "Neumorphism", "file": "themes/neumorphism.css", "style": "light", "scenario": "产品介绍、企业汇报、方案说明", "tags": ["soft", "light", "product"] },
    { "id": "aurora", "name": "炫光紫绿风", "nameEn": "Neon Aurora", "file": "themes/aurora.css", "style": "dark", "scenario": "科技发布会、AI/自动驾驶/机器人、增长故事", "tags": ["neon", "dark", "tech"] },
    { "id": "code", "name": "深浅代码风", "nameEn": "Code Theme", "file": "themes/code.css", "style": "dark", "scenario": "编程、开发者工具、技术文档", "tags": ["code", "dark", "dev"] },
    { "id": "glass-candy", "name": "玻璃糖果风", "nameEn": "Glass Candy", "file": "themes/glass-candy.css", "style": "light", "scenario": "年轻化品牌、创意活动、社交媒体", "tags": ["glass", "candy", "colorful"] },
    { "id": "chromatic", "name": "色谱图表风", "nameEn": "Chromatic Data", "file": "themes/chromatic.css", "style": "light", "scenario": "数据报告、分析图表、学术展示", "tags": ["data", "chart", "colorful"] },
    { "id": "dark-atlas", "name": "深色图谱风", "nameEn": "Dark Atlas", "file": "themes/dark-atlas.css", "style": "dark", "scenario": "地理/网络图谱、宏观分析、全景展示", "tags": ["dark", "map", "network"] },
    { "id": "research-white", "name": "冷白调研风", "nameEn": "Research White", "file": "themes/research-white.css", "style": "light", "scenario": "研究报告、白皮书、学术论文", "tags": ["clean", "white", "research"] },
    { "id": "black-gold", "name": "黑金实验风", "nameEn": "Black Gold", "file": "themes/black-gold.css", "style": "dark", "scenario": "高端品牌、奢侈品、发布会", "tags": ["luxury", "black", "gold"] },
    { "id": "navy-magazine", "name": "深蓝杂志风", "nameEn": "Navy Magazine", "file": "themes/navy-magazine.css", "style": "dark", "scenario": "时尚杂志、深度报道、品牌故事", "tags": ["magazine", "navy", "editorial"] },
    { "id": "gold-index", "name": "金色指数风", "nameEn": "Gold Index", "file": "themes/gold-index.css", "style": "dark", "scenario": "金融指数、投资报告、增长数据", "tags": ["finance", "gold", "index"] },
    { "id": "growth", "name": "高能增长风", "nameEn": "High Energy Growth", "file": "themes/growth.css", "style": "light", "scenario": "营销活动、增长黑客、创业路演", "tags": ["energy", "growth", "vibrant"] },
    { "id": "sonic-neon", "name": "声波霓虹风", "nameEn": "Sonic Neon", "file": "themes/sonic-neon.css", "style": "dark", "scenario": "音乐、游戏、电竞赛事、潮流活动", "tags": ["neon", "music", "game"] }
  ],
  "layouts": [
    {
      "id": "poster-1080x1440",
      "name": "竖版海报 3:4",
      "file": "layouts/poster-1080x1440.html",
      "description": "标准社交媒体竖版海报，1080×1440，适合活动宣传/产品推广",
      "size": "1080x1440",
      "tags": ["poster", "social", "vertical"]
    },
    {
      "id": "poster-1080x1920",
      "name": "手机壁纸海报 9:16",
      "file": "layouts/poster-1080x1920.html",
      "description": "手机全屏海报，1080×1920，适合朋友圈/抖音封面",
      "size": "1080x1920",
      "tags": ["poster", "mobile", "story"]
    },
    {
      "id": "landing-page",
      "name": "落地页",
      "file": "layouts/landing-page.html",
      "description": "单页落地页，含 hero + 特性区 + 数据区 + CTA + 页脚",
      "size": "responsive",
      "tags": ["landing", "web", "responsive"]
    },
    {
      "id": "presentation",
      "name": "网页演示文稿",
      "file": "layouts/presentation.html",
      "description": "多页演示文稿，含翻页/进度条/全屏交互",
      "size": "responsive",
      "tags": ["presentation", "slides", "interactive"]
    },
    {
      "id": "presentation-gsap",
      "name": "网页演示文稿（GSAP 动画版）",
      "file": "layouts/presentation-gsap.html",
      "description": "多页演示，4 种专业翻页过渡（圆形遮罩/像素化/切片/视差），适合发布会/路演",
      "size": "responsive",
      "deps": ["vendor/gsap.min.js", "effects/animations/gsap-transitions.js"],
      "tags": ["presentation", "gsap", "animation", "premium"]
    },
    {
      "id": "dashboard",
      "name": "数据仪表盘",
      "file": "layouts/dashboard.html",
      "description": "数据看板，含统计卡片+图表区+列表",
      "size": "responsive",
      "tags": ["dashboard", "data", "chart"]
    }
  ],
  "components": [
    { "id": "glass-card", "name": "毛玻璃卡片", "category": "card", "file": "components/card/glass-card.html", "description": "半透明毛玻璃效果卡片，适合内容块/特性展示", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["glass", "card"] },
    { "id": "neumorphic-card", "name": "拟态卡片", "category": "card", "file": "components/card/neumorphic-card.html", "description": "轻拟态浮雕卡片，适合产品展示/方案说明", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["neumorphism", "card"] },
    { "id": "gradient-card", "name": "渐变卡片", "category": "card", "file": "components/card/gradient-card.html", "description": "渐变背景卡片，适合强调/高亮内容", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["gradient", "card"] },
    { "id": "bento-grid", "name": "便当盒网格", "category": "grid", "file": "components/grid/bento-grid.html", "description": "大小不一的网格卡片布局，Apple 风格，适合多内容展示", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["bento", "grid", "layout"] },
    { "id": "masonry", "name": "瀑布流", "category": "grid", "file": "components/grid/masonry.html", "description": "瀑布流布局，适合图片墙/作品集", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["masonry", "gallery", "images"] },
    { "id": "particles-hero", "name": "粒子背景封面", "category": "hero", "file": "components/hero/particles-hero.html", "description": "全屏粒子动画背景封面，适合科技/发布主题", "deps": ["particles.js CDN"], "tags": ["particles", "hero", "animation"] },
    { "id": "gradient-hero", "name": "渐变封面", "category": "hero", "file": "components/hero/gradient-hero.html", "description": "纯 CSS 渐变+几何图形封面，无外部依赖，轻量", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["gradient", "hero", "lightweight"] },
    { "id": "waves-hero", "name": "波浪背景封面", "category": "hero", "file": "components/hero/waves-hero.html", "description": "SVG 波浪动画背景封面，适合海洋/流动主题", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["waves", "hero", "svg"] },
    { "id": "stat-card", "name": "数字统计卡片", "category": "data", "file": "components/data/stat-card.html", "description": "大数字+标签的统计卡片，适合关键指标展示", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["stat", "number", "metric"] },
    { "id": "chart-container", "name": "图表容器（多类型）", "category": "data", "file": "components/data/chart-container.html", "description": "Chart.js 图表：折线/柱状/环形饼图/雷达，data-type 属性切换，本地 vendor 离线可用", "deps": ["vendor/chart.umd.min.js"], "tags": ["chart", "data", "line", "bar", "doughnut", "radar"] },
    { "id": "progress-bar", "name": "进度条", "category": "data", "file": "components/data/progress-bar.html", "description": "动画进度条，适合技能/进度/达成率展示", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["progress", "bar", "animation"] },
    { "id": "tabs", "name": "标签切换", "category": "nav", "file": "components/nav/tabs.html", "description": "Tab 标签页切换，适合分类内容展示", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["tabs", "navigation"] },
    { "id": "progress-dots", "name": "进度指示器", "category": "nav", "file": "components/nav/progress-dots.html", "description": "圆点进度指示器，适合多步骤/翻页流程", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["progress", "dots", "pagination"] },
    { "id": "gradient-text", "name": "渐变文字", "category": "text", "file": "components/text/gradient-text.html", "description": "渐变填充文字，适合标题强调", "deps": ["core/utils.css"], "tags": ["gradient", "text", "title"] },
    { "id": "typing-effect", "name": "打字机效果", "category": "text", "file": "components/text/typing-effect.html", "description": "打字机逐字显示效果，适合 slogan/动态标题", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["typing", "animation", "text"] },
    { "id": "reveal-text", "name": "文字逐行出现", "category": "text", "file": "components/text/reveal-text.html", "description": "滚动进入视口时文字逐行显现", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["reveal", "scroll", "text"] },
    { "id": "social-footer", "name": "社交图标页脚", "category": "footer", "file": "components/footer/social-footer.html", "description": "含社交图标的页脚，适合落地页/品牌页", "deps": ["core/reset.css", "core/variables.css", "core/utils.css"], "tags": ["footer", "social", "icons"] }
  ],
