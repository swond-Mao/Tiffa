# Python runtime (site-packages, Playwright, etc.)
Lib/
include/
install/
scripts/

# Dependencies & runtime
npm-global/
node/
python/
home/

# Build artifacts & cache
.temp/
__pycache__/
*.pyc

# Workspace (user data, sessions)
workspace/

# Large binaries
omp-desktop.exe

# Session & cache data
data/agent/sessions/
data/agent/sessions-archive/
data/agent/agent.db*
data/agent/models.db*
data/agent/hidden-models.json
data/agent/session-model-map.json
data/agent/projects.json
data/agent/xml-translation-enabled
data/agent/blobs/
data/agent/models.yml
data/agent/models.yml.bak*
data/agent/models.yml.example
data/cache/
data/agent/cache/
data/memory/
local_cache/

# Mnemopi runtime (databases + embedding cache)
data/agent/memories/
data/agent/mnemopi/
!data/agent/mnemopi/tokenizer.json
!data/agent/mnemopi/model_optimized.onnx
!data/agent/mnemopi/ort_config.json
!data/agent/mnemopi/vocab.txt
