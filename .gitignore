# Log files
data/log/
plugins/*.log
skills/*/*.log
electron/stdout.log
electron/stderr.log

# Tencent Docs export temp files
.tx_export_tmp_*

# Backup files
*.bak*
plugins/*.bak*

# Unreferenced image backups (keep local, never push)
electron/renderer/assets/tiffa-muse(1).png
electron/renderer/assets/tiffa-musebak.png

# Electron runtime
electron/node_modules/
electron/package-lock.json

# Skill output/artifacts (user-generated)
skills/*/output/
skills/dashiai-ppt/project/output/

# Skill vendor/build dirs (large, reproducible)
skills/dashiai-ppt/project/node_modules/
skills/dashiai-ppt/project/.cache/
skills/dashiai-ppt/output/
skills/craftman/output/
skills/*/node_modules/
