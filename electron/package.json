{
  "name": "oh-my-tiffa",
  "version": "1.4.0",
  "description": "oh-my-tiffa - Portable AI coding assistant with Electron frontend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "dev": "electron . --dev"
  },
  "author": "tiffa",
  "license": "MIT",
  "devDependencies": {
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron": "^33.0.0",
    "highlight.js": "^11.10.0",
    "marked": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.tiffa.desktop",
    "productName": "tiffa",
    "directories": {
      "output": "../dist"
    },
    "win": {
      "target": "portable",
      "icon": null
    },
    "portable": {
      "artifactName": "tiffa-portable-${version}.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*",
      "!node_modules/electron/dist/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "../npm-global",
        "to": "npm-global",
        "filter": [
          "**/*",
          "!**/node_modules/@oh-my-pi/pi-coding-agent/src/**/*",
          "!**/node_modules/@oh-my-pi/pi-coding-agent/examples/**/*",
          "!**/node_modules/@oh-my-pi/pi-coding-agent/docs/**/*"
        ]
      },
      {
        "from": "../plugins",
        "to": "plugins"
      },
      {
        "from": "../data",
        "to": "data"
      },
      {
        "from": "../home",
        "to": "home"
      },
      {
        "from": "../workspace",
        "to": "workspace"
      }
    ],
    "asar": false
  }
}
