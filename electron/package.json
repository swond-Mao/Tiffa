{
  "name": "oh-my-tiffa",
  "version": "1.4.0",
  "description": "oh-my-tiffa - Portable AI coding assistant with Electron frontend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "dev": "electron . --dev",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "dev:renderer": "vite build --watch --config renderer/vite.config.ts",
    "typecheck": "tsc --noEmit -p renderer/tsconfig.json",
    "test:renderer": "vitest run --config renderer/vitest.config.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs && node scripts/e2e-session.mjs",
    "test:e2e:smoke": "node scripts/e2e-smoke.mjs",
    "test:e2e:session": "node scripts/e2e-session.mjs",
    "test:capture": "node scripts/capture-select.mjs",
    "test:unit": "node main.test.js && npm run test:renderer",
    "test:all": "npm run typecheck && npm run test:unit && npm run build:renderer",
    "release": "node scripts/release.mjs"
  },
  "author": "Tiffa",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-builder": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^4.5.5"
  },
  "dependencies": {
    "electron": "^33.0.0",
    "highlight.js": "^11.10.0",
    "marked": "^15.0.0",
    "yaml": "^2.9.0"
  },
  "build": {
    "appId": "com.tiffa.desktop",
    "productName": "Tiffa",
    "directories": {
      "output": "../dist"
    },
    "win": {
      "target": "portable",
      "icon": "assets/tiffa-icon.ico"
    },
    "mac": {
      "icon": "assets/icons/icon-512.png"
    },
    "linux": {
      "icon": "assets/icons/icon-256.png",
      "category": "Development"
    },
    "portable": {
      "artifactName": "tiffa-portable-${version}.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/dist/**/*",
      "node_modules/**/*",
      "!node_modules/electron/dist/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "../npm-global",
        "to": "npm-global",
        "filter": [
          "**/*",
          "!**/node_modules/@oh-my-pi/pi-coding-agent/src/**/*",
          "!**/node_modules/@oh-my-pi/pi-coding-agent/examples/**/*",
          "!**/node_modules/@oh-my-pi/pi-coding-agent/docs/**/*"
        ]
      },
      {
        "from": "../plugins",
        "to": "plugins"
      },
      {
        "from": "../data",
        "to": "data"
      },
      {
        "from": "../home",
        "to": "home"
      },
      {
        "from": "../workspace",
        "to": "workspace"
      }
    ],
    "asar": false
  }
}
